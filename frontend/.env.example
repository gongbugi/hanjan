# 로컬 개발: cp .env.example .env.local
VITE_API_BASE_URL=http://localhost:8000

# dev: 백엔드 HANJAN_AUTH_MODE=dev 와 짝. 로그인 버튼이 개발용 토큰을 쓴다
# firebase: 운영. 아래 Firebase 웹 앱 설정이 필요하다 (공개돼도 되는 값이다 — 권한은 서버 허용 목록이 정한다)
VITE_AUTH_MODE=dev
VITE_DEV_TOKEN=dev-admin

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
